# =============================================================================
# 365 SHOP — Git Ignore
# =============================================================================

# Dependencies
/node_modules
/.pnp
.pnp.*

# Package manager
.pnpm-store
.pnpm-debug.log*

# Yarn files
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js
/.next/
/out/
next-env.d.ts

# Production
/build
/dist

# TypeScript
*.tsbuildinfo

# Testing / Coverage
/coverage
/test-results
/playwright-report

# Storybook
/storybook-static

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Environment files
.env
.env.*
!.env.example
!.env.local.example

# Vercel
.vercel

# OS / Editor
.DS_Store
Thumbs.db
.idea
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Certificates / Secrets
*.pem
*.key
*.cert